# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models for the two AI steps. Defaults are Google's "latest" aliases.
# Small model: understands each typed message. Large model: reads the handbook.
GEMINI_MODEL_SMALL=gemini-flash-lite-latest
GEMINI_MODEL_LARGE=gemini-flash-latest

# Shared database. Vercel's Upstash for Redis integration sets these automatically.
# Leave empty locally to use a temporary in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
