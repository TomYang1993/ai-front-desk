# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models for the two AI steps, pinned to specific versions. Free-tier limits are
# per model per day (some are as low as 20), so each step falls back through
# several models. Small model: understands each typed message. Large model:
# reads the handbook.
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_SMALL_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_MODEL_LARGE=gemini-3.6-flash
GEMINI_MODEL_LARGE_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Shared database. Vercel's Upstash for Redis integration sets these automatically.
# Leave empty locally to use a temporary in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
