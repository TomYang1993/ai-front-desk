# Copy this file to .env.local and fill in the values, or run `npx vercel env pull .env.local`.
# Never commit .env.local.

# AI providers. Configure at least one. Models for a provider without a key are skipped.
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional local models through Ollama's OpenAI-compatible endpoint.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: override the model order for each step, as "provider:model", comma separated.
# The small step understands messages, translates and checks claims. The large step reads the handbook.
# MODELS_SMALL=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash-lite
# MODELS_LARGE=groq:openai/gpt-oss-120b,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite

# Shared database. Vercel's Upstash for Redis integration sets these automatically.
# Leave empty locally to use a temporary in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
